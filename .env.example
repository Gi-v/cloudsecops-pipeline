# ── App ──────────────────────────────────────────
APP_ENV=development
# Also the JWT HS256 signing secret (app/core/security.py) — keep at 32+
# characters even for local dev to satisfy RFC 7518's recommended HMAC key
# length; use a real random value (e.g. `openssl rand -hex 32`) in any real
# deployment.
APP_SECRET_KEY=change-me-in-production-please-32-chars-min
LOG_LEVEL=INFO

# ── Postgres ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloudsecops
POSTGRES_USER=cloudsecops
POSTGRES_PASSWORD=cloudsecops_dev_password
DATABASE_URL=postgresql+asyncpg://cloudsecops:cloudsecops_dev_password@localhost:5432/cloudsecops

# ── Kafka ────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_FINDINGS_RAW=findings.raw
KAFKA_TOPIC_FINDINGS_ENRICHED=findings.enriched
KAFKA_TOPIC_ALERTS=alerts.critical
KAFKA_CONSUMER_GROUP=policy-engine

# ── MinIO (S3-compatible evidence store) ─────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=cloudsecops
MINIO_SECRET_KEY=cloudsecops_dev_secret
MINIO_BUCKET=evidence-store
MINIO_SECURE=false

# ── OPA (Open Policy Agent) ───────────────────────
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=/v1/data/cloudsecops

# ── Redis (cache + rate limiting) ─────────────────
REDIS_URL=redis://localhost:6379/0

# ── Simulated cloud collectors ────────────────────
# No real cloud credentials required — collectors run in
# SIMULATE mode by default and generate realistic synthetic
# resource inventories. Set to "live" + provide real creds
# to point at actual AWS/GCP/Azure accounts.
COLLECTOR_MODE=simulate
# Run one scan automatically on backend startup so the dashboard is never empty
# on first load — this is what makes `docker compose up` feel instantly alive.
AUTO_SEED_ON_STARTUP=true
RATE_LIMIT_SCAN_PER_MINUTE=6

# ── Auth: legacy API key (service-account / automation) ──
# Off by default so the demo stays frictionless. Flip on + set a key for
# anything resembling a real deployment. Coexists with the JWT login below —
# either one satisfies the admin-only gate on POST /api/v1/scan, PATCH
# /api/v1/findings/*/status, and PATCH /api/v1/findings/bulk-status.
API_AUTH_ENABLED=false
API_KEY=

# ── Auth: JWT login (human users, RBAC) ───────────
# Reuses APP_SECRET_KEY above as the HS256 signing secret. A default admin
# account is created on first boot if no users exist yet — change the
# password immediately in any real deployment.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTO_SEED_ADMIN_ON_STARTUP=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-on-first-login
RATE_LIMIT_LOGIN_PER_MINUTE=10

# ── CORS ───────────────────────────────────────────
# Comma-separated allowed origins. Can't be "*" while the API sends
# credentialed responses (browsers reject a wildcard origin on those) — list
# every real frontend origin here instead.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Alerting ───────────────────────────────────────
# Generic JSON POST webhook (Slack/Discord-incoming-webhook compatible
# payload shape) fired for every CRITICAL finding. Leave blank to just log
# critical alerts instead of delivering them anywhere.
ALERT_WEBHOOK_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
GCP_PROJECT_ID=
GCP_CREDENTIALS_JSON=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Frontend ───────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
# Powers the Sidebar's "Grafana" link (see docker-compose.yml's grafana
# service) — anonymous viewer access is enabled on that container, so this
# opens straight into the dashboard with no separate login.
VITE_GRAFANA_URL=http://localhost:3001
